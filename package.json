{
  "name": "@goost/opencode-model-preferences",
  "version": "0.1.0",
  "description": "OpenCode plugin for mapping preferred models to agents, sub-agents, and slash commands",
  "type": "module",
  "main": "src/index.ts",
  "types": "dist/index.d.ts",
  "author": "Anomaly",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.1.34",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "src",
    "commands"
  ],
  "keywords": [
    "opencode",
    "plugin",
    "model-preferences",
    "agent-routing"
  ],
  "license": "MIT"
}
